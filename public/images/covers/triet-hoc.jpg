<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_triet-hoc" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18181b" />
      <stop offset="100%" stop-color="#27272a" />
    </linearGradient>
    <linearGradient id="spine_grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#000000" stop-opacity="0.6"/>
      <stop offset="60%" stop-color="#000000" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05"/>
    </linearGradient>
    <pattern id="grid_triet-hoc" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e4e4e7" stroke-opacity="0.07" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Nền chính -->
  <rect width="600" height="800" fill="url(#grad_triet-hoc)" />
  <rect width="600" height="800" fill="url(#grid_triet-hoc)" />

  <!-- Khung viền chỉ vàng/accent nghệ thuật -->
  <rect x="40" y="40" width="520" height="720" rx="16" fill="none" stroke="#e4e4e7" stroke-opacity="0.25" stroke-width="2" />
  <rect x="48" y="48" width="504" height="704" rx="12" fill="none" stroke="#e4e4e7" stroke-opacity="0.15" stroke-width="1" />

  <!-- Huy hiệu thương hiệu Header -->
  <g transform="translate(300, 120)" text-anchor="middle">
    <rect x="-130" y="-22" width="260" height="44" rx="22" fill="#000000" fill-opacity="0.35" stroke="#e4e4e7" stroke-opacity="0.3" stroke-width="1"/>
    <text y="6" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#e4e4e7" letter-spacing="3">TIỂU ĐỘI 2P • THƯ VIỆN SỐ</text>
  </g>

  <!-- Icon biểu tượng trung tâm -->
  <g transform="translate(300, 270)">
    <circle r="60" fill="#e4e4e7" fill-opacity="0.12" stroke="#e4e4e7" stroke-opacity="0.35" stroke-width="2"/>
    <circle r="72" fill="none" stroke="#e4e4e7" stroke-opacity="0.15" stroke-width="1" stroke-dasharray="4 6"/>
    <text y="14" font-family="system-ui, sans-serif" font-size="34" font-weight="900" fill="#e4e4e7" text-anchor="middle" letter-spacing="2">PHI</text>
  </g>

  <!-- Tiêu đề chuyên mục -->
  <g transform="translate(300, 460)" text-anchor="middle">
    <text font-family="system-ui, sans-serif" font-size="28" font-weight="900" fill="#ffffff" letter-spacing="2">TRIẾT HỌC ĐÔNG TÂY</text>
    <line x1="-80" y1="25" x2="80" y2="25" stroke="#e4e4e7" stroke-width="3" stroke-linecap="round"/>
    <text y="58" font-family="system-ui, sans-serif" font-size="16" font-weight="500" fill="#cbd5e1" fill-opacity="0.9">Tư tưởng & Nhân sinh quan</text>
  </g>

  <!-- Footer con dấu lưu chiểu -->
  <g transform="translate(300, 680)" text-anchor="middle">
    <text font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#e4e4e7" letter-spacing="4">OFFICIAL ARCHIVE</text>
    <text y="24" font-family="system-ui, sans-serif" font-size="11" font-weight="500" fill="#94a3b8">Bản Lưu Chiểu Chuẩn Học Thuật</text>
  </g>

  <!-- Hiệu ứng gáy sách cổ điển bóng mép trái -->
  <rect x="0" y="0" width="32" height="800" fill="url(#spine_grad)" />
  <line x1="32" y1="0" x2="32" y2="800" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1"/>
</svg>